{
  "name": "dsh-plugin-search",
  "version": "0.5.0",
  "description": "Search DSH plugins on the npm registry by a name fragment and install them from the Plugins page.",
  "author": "yaqiangsun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaqiangsun/dsh-plugin-search.git"
  },
  "homepage": "https://github.com/yaqiangsun/dsh-plugin-search#readme",
  "bugs": {
    "url": "https://github.com/yaqiangsun/dsh-plugin-search/issues"
  },
  "type": "module",
  "scripts": {
    "check": "node scripts/check-plugin.mjs",
    "check:search": "node scripts/check-search-plugin.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "search",
    "discovery",
    "npm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
